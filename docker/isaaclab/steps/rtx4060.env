# RTX 4060 (VRAM 8GB, 노트북) 용 설정값.
#
#   source docker/isaaclab/steps/rtx4060.env
#
# 왜 필요한가: Isaac Sim 5.1 의 공식 최소 GPU 는 RTX 4080 16GB 입니다.
# 4060 8GB 는 그 아래지만 Ada 세대라 RT 코어가 있어서 동작은 합니다.
# 대신 VRAM 이 거의 전부 제약이 되므로 아래 세 가지가 사실상 필수입니다.
#
#   1) 학습은 반드시 --headless   : GUI 렌더러가 VRAM 3~4GB 를 먼저 먹습니다
#   2) --num_envs 를 작게 시작    : 기본값(4096)은 8GB 에서 무조건 OOM 입니다
#   3) --enable_cameras 는 마지막 : 카메라는 env 당 VRAM 을 크게 먹습니다
#      (IsaacLab #604: 카메라 켠 상태로 env 수를 늘리다 476 부근에서 반복 실패한 사례)

# ---------------------------------------------------------------- 메모리
# 단편화로 인한 OOM 을 줄입니다. 10_conda_env.sh 가 환경변수로도 등록해 둡니다.
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# ---------------------------------------------------------------- 권장 시작값
# 두 배씩 올리며 nvidia-smi 로 VRAM 을 보고 한계 직전에서 멈추세요.
# 32 → 64 → 128 → 256. 8GB 에서 256 이 돌았다는 보고가 있지만 태스크마다 다릅니다.
export ISAAC_NUM_ENVS="${ISAAC_NUM_ENVS:-64}"

# 노트북 하이브리드 그래픽(Optimus): 베어메탈에서 GUI 를 띄울 때 dGPU 를 쓰도록 강제.
# 도커 + nvidia-container-toolkit 안에서는 필요 없습니다.
export __NV_PRIME_RENDER_OFFLOAD=1
export __GLX_VENDOR_LIBRARY_NAME=nvidia

# ---------------------------------------------------------------- 쓰는 법
#
# 학습 (헤드리스):
#   isaaclab -p ${ISAACLAB_PATH}/scripts/reinforcement_learning/rsl_rl/train.py \
#     --task Isaac-Velocity-Flat-Anymal-C-v0 --headless --num_envs ${ISAAC_NUM_ENVS}
#
# VRAM 모니터링 (다른 터미널):
#   nvidia-smi --query-gpu=memory.used,memory.total --format=csv -l 2
#
# 가볍게 확인만:
#   isaaclab -p ${ISAACLAB_PATH}/scripts/tutorials/00_sim/create_empty.py --headless
#
# ---------------------------------------------------------------- OOM 났을 때
#
#  · `Out of GPU memory` / `carb.graphics-vulkan`  -> num_envs 를 절반으로
#  · `LLVM ERROR: out of memory`                   -> VRAM 이 아니라 시스템 RAM 쪽입니다.
#                                                     스왑을 늘리고 씬을 단순화하세요.
#  · 종료되지 않고 그냥 멈춤 (IsaacLab #462)        -> OOM 이어도 프로세스가 안 죽습니다.
#                                                     로그에서 Out of GPU memory 를 찾으세요.
#  · 노트북은 RAM 16GB 가 흔한데 Isaac Sim 공식 최소는 32GB 입니다.
#    복잡한 씬에서는 VRAM 보다 RAM 이 먼저 터집니다 (IsaacLab #5350).
